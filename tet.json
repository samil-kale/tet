{
  "exclude": [
    ".github/workflows",
    ".claude",
    ".gitignore"
  ],
  "commands": [
    {
      "command": "npm run compile",
      "name": "npm compile",
      "color": "yellow"
    },
    "npm start",
    "npm run watch",
    "npm run typecheck",
    "npm run lint",
    "npm run format",
    "npm run format:check",
    "npm run dist"
  ],
  "sbx": {
    "enabled": false,
    "ports": [],
    "paths": [],
    "hosts": [],
    "environment": [
      "CLAUDE_CODE_SCROLL_SPEED"
    ],
    "mcp": [],
    "setup": []
  }
}
