{
  "settings": {
    "files.exclude": {
      ".github/workflows": true,
      ".claude": true,
      ".gitignore": true
    },
    "explorer.excludeGitIgnore": true
  },
  "commands": [
    {
      "command": "npm run compile",
      "name": "npm compile"
    },
    "npm start",
    "npm run watch",
    "npm run typecheck",
    "npm run lint",
    "npm run dist"
  ]
}
