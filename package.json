{
  "name": "tet",
  "version": "0.3.7",
  "private": true,
  "description": "Git workspace for coding agents",
  "author": "Samil Kale",
  "license": "MIT",
  "main": "./dist/main.js",
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "start": "npm run typecheck && npm run compile && electron .",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "test": "npm run compile && node --test \"dist-test/*.test.js\"",
    "dist": "npm run compile -- --production && electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-pty": "1.2.0-beta.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/monaco": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "monaco-editor": "^0.56.0",
    "monaco-editor-core": "^0.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "^4.4.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
